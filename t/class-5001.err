class a {
	fun() { ##ERROR: syntax error - unnamed function defined with 'fun' prohibited in class initialziation context
	}
}

---

class X10 {
	var x
     fun[#ci] make() { x := 1234; return self; };
     fun get-x() { return x };
}

X11 := (class:X10 {
})

## as above - the name is already claimed at compile time by 'X11 :='.
class X11 { ##ERROR: syntax error - duplicate name 'X11' for class
}

