## TODO: some of these can be detected as an error at the compile time..

class[#b] X (a) {
	fun[#ci] new() {
		## the instance variable is a byte because the class is a byte-oriented class
		self.a := -20 ##ERROR: exception not handled - "negative number - -20"
	}
}

X:new

---

class[#b] X (a) {
	fun[#ci] new() {
		## the instance variable is a byte because the class is a byte-oriented class
		self.a := -20 ##ERROR: exception not handled - "negative number - -20"
	}
}

class Y: X { ##ERROR: exception not handled - "incompatible byte superclass X with oop class"
}

---

## you can't send a binary message to an object the receiver:message syntax.
## you must omit the colon for the binary message
## it must be '20 == 40'

fun Number:==(b) { return (core.+ self b) }
20 :== 40  ##ERROR: syntax error - prohibited binary selector '=='

---

## a builtin primitive occupies the name already. a kernel class being
## completed is a different case - the bit that marks a primitive sits on the
## name symbol, not on the value.

class printf { ##ERROR: syntax error - prohibited redefinition of primitive 'printf'
}

---

## '#reopen' adds to a class that is already there, so the name must hold one.
## nothing has bound this name at all.

class[#reopen] Zz { ##ERROR: syntax error - prohibited reopening of undeclared name 'Zz'
}

---

## a name mentioned somewhere is not a definition either.

fun t() { return (Mm) }
class[#reopen] Mm { ##ERROR: syntax error - prohibited reopening of undeclared name 'Mm'
}

---

## a variable holds a value, not a class - whatever value it was later given.
## see HAK_OBJ_FLAGS_VARKIND.

var Vv
class[#reopen] Vv { ##ERROR: syntax error - prohibited reopening of variable 'Vv'
}

---

## nor does a function. '#rebind' is the attribute for that side.

fun Ff() { return 1 }
class[#reopen] Ff { ##ERROR: syntax error - prohibited reopening of function 'Ff'
}

---

## a global a store created is a value, not a definition.

Ww := 5
class[#reopen] Ww { ##ERROR: syntax error - prohibited reopening of name 'Ww'
}

---

## an unnamed class binds no name and so has nothing to reopen.

q := (class[#reopen] { ##ERROR: syntax error - class attribute '#reopen' prohibited on an unnamed class
})

---

## a reopening keeps the class object the instances already made point at, so
## it may not change the shape of an instance. CLASS_ENTER compares the
## declaration against the class it found.

class Kk (a) {
}
class[#reopen] Kk (a b) { ##ERROR: exception not handled - "incompatible reopening of Kk"
}

---

## without '#reopen' the name is simply taken, and saying so at compile time is
## better than letting the second definition quietly win.

class Kk {
}
class Kk { ##ERROR: syntax error - duplicate name 'Kk' for class
}

---

## a 'var' declaration claims the name at compile time, so the class that
## follows is a duplicate - the mirror of 'var F' after 'class F' in
## t/var-5005.err.

var Vc
class Vc { ##ERROR: syntax error - duplicate name 'Vc' for class
}

---

## and so does a function definition.

fun Fc() { return 1 }
class Fc { ##ERROR: syntax error - duplicate name 'Fc' for class
}

---

## '#reopen' does not reach a primitive either. the kernel bit on the name
## symbol is consulted before the declaring form, so the complaint names what
## is actually in the way.

class[#reopen] printf { ##ERROR: syntax error - prohibited redefinition of primitive 'printf'
}
