## the external process supervision layer in src/external-process.hak

$include-once "external-process.hak"
$include-once "process.hak"

fun chk(ok msg) {
	if ok { printf "OK: %s\n" msg } \
	else { printf "ERROR: %s\n" msg }
}

## --- members are collected in completion order, whichever finishes first ---
g := (ExternalProcessGroup:new)
chk (= (g:count) 0) "a new group watches nothing"
a := (g:spawn "sleep 3; exit 11" "r")
b := (g:spawn "sleep 1; exit 22" "r")
c := (g:spawn "sleep 2; exit 33" "r")
chk (= (g:count) 3) "spawn adds to the group"
chk (integer? (a:proc)) "the process carries a process handle"
chk (nqv? (a:out) nil) "...and the requested stream"
chk (nil? (a:in)) "...and nil for one not requested"
chk (a:isRunning?) "...and reports itself still running"

ticks := 0
fun ticker() {
	while (< ticks 5) {
		ticks := (+ ticks 1)
		Process:yield
	}
}
Process:fork ticker

order := (core.basicNew Array 3)
n := 0
while (< n 3) {
	p := (g:wait 25)
	if (nil? p) {
		printf "ERROR: g:wait timed out\n"
		n := 3
	} \
	else {
		core.basicAtPut order n (p:status)
		g:close p
		n := (+ n 1)
	}
}

chk (= (core.basicAt order 0) 22) "the first to finish was reported first"
chk (= (core.basicAt order 1) 33) "then the second"
chk (= (core.basicAt order 2) 11) "then the third"
chk (= ticks 5) "coprocesses ran while the group waited"
chk (= (g:count) 0) "close removes a member from the group"
g:done

## --- simultaneous exits ---
## standard signals do not queue, so on the SIGCHLD path one signal can stand
## for every one of these; the group must still account for all of them.
g2 := (ExternalProcessGroup:new)
i := 0
while (< i 6) {
	g2:spawn "sleep 1; exit 7" "r"
	i := (+ i 1)
}
seen := 0
bad := 0
while (< seen 6) {
	p := (g2:wait 25)
	if (nil? p) {
		printf "ERROR: timed out with members unaccounted for\n"
		seen := 6
		bad := 1
	} \
	else {
		if (not (= (p:status) 7)) { bad := 1 }
		g2:close p
		seen := (+ seen 1)
	}
}
chk (= bad 0) "six processes exiting together were all collected"
g2:done

## --- a timeout is reported as nil, not as a hang ---
g3 := (ExternalProcessGroup:new)
g3:spawn "sleep 30" "r"
chk (= (g3:count) 1) "the group is watching the long-running process"
chk (nil? (g3:wait 1)) "g:wait returns nil when nothing finishes in time"
g3:done
chk (= (g3:count) 0) "g:done emptied a group that still held a running process"

## --- an ExternalProcess on its own, with no group ---------------------------
## The layer is usable for a single process too: open it, read it, ask it for
## its status, close it. Nothing here touches a semaphore or a group.
p1 := (ExternalProcess:open "echo hello; exit 5" "r")
chk (integer? (p1:proc)) "an ungrouped process carries a process handle"
chk (nil? (p1:sem)) "...and no semaphore, since no group bound one"

## reading is plainly synchronous - no semaphore, no would-block, no retry.
## the process blocks; the vm does not.
chk (eql? ((p1:out):readBytes 5) (core.encode-chars "hello")) "...and its output reads back as bytes"

## an ungrouped process has no semaphore to be woken by, so this polls -
## which is exactly the cost the group exists to avoid. a timed semaphore
## supplies the delay without blocking other coprocesses.
nap := (core.sem-new)
j := 0
while (and (< j 50) (p1:isRunning?)) {
	core.sem-signal nap 0 100000000
	core.sem-wait nap
	core.sem-unsignal nap
	j := (+ j 1)
}
chk (not (p1:isRunning?)) "...and it reports when it has finished"
chk (= (p1:status) 5) "...with the exit status it chose"
p1:close
