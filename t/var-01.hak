fun x (a b :: r) {
	
	| x y |

	set x a
	set y b

	if (> a b) {
		| a b |
		set a (mod x y)
		set b (+ x y)
		set r (* a b)
	} else {
		| a b |
		set a (* x y)
		set b (- x y)
		set r (* a b)
	}


	if (!= x a) (printf "ERROR: x is not equal to a\n")
	if (!= y b) (printf "ERROR: y is not equal to b\n")
}

t := (x 10 20)
if (!= t -2000) (printf "ERROR: t is not equal to -2000\n") \
else (printf "OK: %d\n" t)
set t (x 30 20)
if (!= t 500) (printf "ERROR: t is not equal to 500\n") \
else (printf "OK: %d\n" t)


fun xx () {

	| xx y |

	set xx 99
	try {
		| xx |
		set xx 88
		if (!= xx 88) (printf "ERROR: xx is not 88\n") \
		else (printf "OK: %d\n" xx)
		throw 1000
	} catch (xx) {
		if (!= xx 1000) (printf "ERROR: xx is not 1000\n") \
		else (printf "OK: %d\n" xx)
		set y xx
	}

	if (!= xx 99) (printf "ERROR: xx is not 99\n") \
	else (printf "OK: %d\n" xx)
	if (!= y 1000) (printf "ERROR: y is not 1000\n") \
	else (printf "OK: %d\n" y)
} 

xx


class T {
	var j

	fun[#classinst] new() {
		set j 99
		return self
	}

	fun x() {
		set R {
			| x |
			set x 1
			while (< x j) {
				## a named function is only accepted at the outermost level, so
				## bind an anonymous one. it still lands in a global.
				Q := (fun() x)
				set x (+ x 1)
			}
		}
	}
}

set t (T:new)
t:x
set t (Q)
if (!= t 99) (printf "ERROR: t is not 99\n") \
else (printf "OK: %d\n" t)

if (nqv? R false) (printf "ERROR: R is not false\n") \
else (printf "OK: %O\n" R)

set v #(
	{ |a b| set a 10; set b 20; + a b }
	{ |a b| set a 11; set b 21; + a b }
   	999
)

set v2 #(30 32 999)

if (nql? v v2) (printf "ERROR: v1 and v2 are not equal\n")\
else (printf "OK: v and v2 equal\n")

