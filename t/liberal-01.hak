## Liberal mode - a bare word is a string, a $word is a name.
##
## The mode is shell-shaped: `x := 5` writes and `$x` reads, and a word that
## names nothing is just text. It is turned on by --liberal for the top-level
## file, or by `$pragma liberal on` from that point in the file onward.
##
## The mode is FILE-SCOPED. It lives on the input stream rather than on the vm,
## so a file that turns it on cannot change how its includer or its includees
## are read. That is what makes it safe to use in a program that pulls in the
## ordinary class library, every line of which is written the normal way.
##
## [NOTE] this file is driven by t/run.sh, which does not pass --liberal, so
## everything below goes through the pragma. The two are the same bit - see
## hak_attachccio() for the flag and feed_process_token() for the pragma.

## [NOTE] chk is defined up here, BEFORE any pragma, so its body compiles in
## the ordinary mode. Were it defined inside a liberal region its parameters
## would compile to the strings "ok" and "msg" - and a non-empty string is
## truthy, so every assertion would report OK and this file would pass no
## matter what broke. A helper used by a liberal test has to be compiled
## strict, or it stops being able to fail.
fun chk(ok msg) {
	if ok { printf "OK: %s\n" msg } \
	else { printf "ERROR: %s\n" msg }
}

## --- the two readings of a word ----------------------------------------------

x := 5

$pragma liberal on

chk (eql? x "x") "a bare word is a string literal"
chk (eqv? $x 5) "a $-prefixed word is a variable reference"
## [NOTE] core.className answers a Symbol, not a String, so the comparison is
## against a symbol literal rather than a quoted one.
chk (eqv? (core.className (core.classOf x)) #String) "...and the bare word really is a String"

## assignment still takes a bare name on the left, as in a shell
y := 7
chk (eqv? $y 7) "assignment names its target without the sigil"

$pragma liberal off

chk (eqv? x 5) "with the pragma off a bare word is a variable again"
chk (eqv? y 7) "...and the variable the liberal half assigned is the same one"

## --- the positions where a name is required ----------------------------------
##
## A bare word stays a name where nothing else would make sense: the callee of
## a call, and the superclass of a class. Everything else is text.

$pragma liberal on

## the callee keeps its ordinary meaning - this would answer the string "idf"
## rather than calling anything if the rule applied there too.
fun idf(v) { return $v }
chk (eqv? (idf 42) 42) "the callee of a call resolves as a name"

## ...while the very same word is text one position to the right
chk (eql? (idf idf) "idf") "...and is text anywhere else"

class K: Object { }
chk (eqv? (core.className $K) #K) "a class may name its superclass"

class L { }
chk (eqv? (core.className $L) #L) "...and a class without one still works"

class M: K { }
chk (eqv? (core.className $M) #M) "...and the superclass may be a user class"

## a dotted name is always a reference - it never needs the sigil
chk (eqv? (core.basicSize "abc") 3) "a dotted name needs no sigil"

## a message send to a $-variable
s := "abc"
chk (eqv? (core.basicSize $s) 3) "a $-variable can be passed along"

$pragma liberal off

## --- words that are not identifiers at all -----------------------------------
##
## The rule above is the compiler's, and it only ever changes what a word that
## could have been a name means. There is a second rule in the lexer, and it
## reaches further: a word carrying an operator character - a+b, eth0=up,
## --force - is neither a pure identifier nor an operator, so in ordinary mode
## it is refused as an illegal identifier before anything asks what it means.
## Liberal mode lexes it as a string literal instead. That is what lets
## shell-shaped text be written unquoted.
##
## [NOTE] the refusal itself is in liberal-5001.err. It cannot be asserted here,
## because a syntax error stops the file rather than failing one assertion.

$pragma liberal on

chk (eql? a+b "a+b") "a word with an operator character in it is text"
chk (eql? eth0=up "eth0=up") "...so is one with an equals sign"
chk (eql? x>1 "x>1") "...and one with an angle bracket"
chk (eql? --force "--force") "...and one that looks like a command-line switch"
chk (eqv? (core.className (core.classOf a+b)) #String) "the result really is a String"
chk (eqv? (core.basicSize a+b) 3) "...an ordinary one, with a length of its own"

## the exemptions above do not apply to this rule. the lexer has not yet been
## told what position the word sits in, so a punctuated word is text even where
## a pure word would have stayed a name. the two give different failures in
## callee position, which is how they can be told apart: a pure word reports
## "abc accessed without initialization" because it is still a name, while a
## punctuated one reports "callable a+b not found" because a string got there.
caught := 0
try { (a+b 1) } catch (e) { caught := 1 }
chk (eqv? $caught 1) "a punctuated word is text even in callee position"

$pragma liberal off

## --- the sigil ---------------------------------------------------------------
##
## $word is the other half of the trade. Once a bare word is text, a name has to
## be marked, and the $ is the mark. It is settled in the reader - the token
## becomes an RSYMBOL, which is a reference in every position and never text.
##
## [NOTE] outside liberal mode the $ introduces a directive and nothing else, so
## $word there is a syntax error. That half is in liberal-5001.err too, along
## with the positions that want a bare name and so refuse the sigil.

$pragma liberal on

p := 21
chk (eqv? $p 21) "the sigil reaches a global"
chk (eql? p "p") "...while bare it is only its own text"

do {
	| n |
	n := 3
	chk (eqv? $n 3) "it reaches a local declared with | | as well"
	chk (eql? n "n") "...which bare is likewise just text"
}

## the consequence worth knowing about: inside a liberal region every local and
## parameter read needs the sigil, including in a function whose body was
## written without any idea it would be read this way. this is why the mode
## being file-scoped matters - see the include section below.
fun bare(v) { return v }
chk (eql? (bare 42) "v") "a parameter read bare answers its own name, not the argument"
fun sigil(v) { return $v }
chk (eqv? (sigil 42) 42) "...and the sigil is what asks for the argument"

$pragma liberal off

## --- the mode does not cross an include --------------------------------------
##
## Both directions matter. A liberal file must not reinterpret what it pulls
## in, and a file that turns the mode on must not change its includer.

$pragma liberal on

$include "liberal-inc.hak"
chk (eqv? (libfn 9) 9) "an included file is read in its own mode, not the includer's"

$pragma liberal off

z := 11
$include "liberal-inc2.hak"
chk (eqv? z 11) "a pragma inside an include does not leak back out"

## ...and it holds for a form that is only half written when the include ends.
## A form is compiled once it closes, so asking the current input stream at that
## moment answers for the file that happened to close the form rather than the
## file the word was written in. Each word carries its own mode instead.

arr1 := #[
	$include "liberal-inc3.hak"
]
chk (eql? (core.basicAt arr1 0) "abc") "a word keeps the mode of the file that wrote it, not the one that closes the form"

gv := 77
$pragma liberal on
arr2 := #[
	$include "liberal-inc4.hak"
]
$pragma liberal off
chk (eqv? (core.basicAt arr2 0) 77) "...and the same holds for a strict word closing inside a liberal form"

## --- what the mode does not change -------------------------------------------

$pragma liberal on

chk (eqv? nil nil) "a keyword is still a keyword"
k := 0
if true { k := 1 } else { k := 2 }
chk (eqv? $k 1) "...and still drives the syntax"
chk (eql? "a string literal" "a string literal") "a quoted string is unaffected"
chk (eqv? 12 12) "a number is unaffected"
chk (eqv? 'c' 'c') "a character is unaffected"
