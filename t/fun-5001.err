## error messages for a bad function name in a 'fun' declaration
##
## Both the plain form and the 'fun Class:name' form quote the offending node.
## A list has no token text of its own, so quoting it used to produce nothing
## at all - 'invalid function name ''' - and the message named no culprit. The
## description now comes from the concode, through hak_getcnodedesc().

fun #(1 2)() {} ##ERROR: syntax error - invalid function name '#( )' for 'fun'

---

fun #[1 2]() {} ##ERROR: syntax error - invalid function name '#[ ]' for 'fun'

---

fun #{1:2}() {} ##ERROR: syntax error - invalid function name '#{ }' for 'fun'

---

## the same, in the position after a class name and a colon

fun X:#(1 2)() {} ##ERROR: syntax error - invalid function name '#( )' after 'X:' for 'fun'

---

fun X:#[1 2]() {} ##ERROR: syntax error - invalid function name '#[ ]' after 'X:' for 'fun'

---

## a name that IS a single token still reports its own text, so the fallback
## path through the same helper is covered as well

fun 5() {} ##ERROR: syntax error - invalid function name '5' for 'fun'

---

fun X:5() {} ##ERROR: syntax error - invalid function name '5' after 'X:' for 'fun'

---

## a named function binds a global, so it is only accepted as a statement at
## the outermost level of the compilation unit - the same rule a named class
## follows. see class-5001.err for the class side of it.

fun outer() {
	fun inner() { ##ERROR: syntax error - prohibited definition of named function 'inner'
		return 1
	}
}

---

## a block at the outermost level is not the outermost level

do { fun h() { ##ERROR: syntax error - prohibited definition of named function 'h'
} }

---

{ fun h() { ##ERROR: syntax error - prohibited definition of named function 'h'
} }

---

if true { fun h() { ##ERROR: syntax error - prohibited definition of named function 'h'
} }

---

## nor is a method body

class A {
	fun[#class] t() {
		fun h() { ##ERROR: syntax error - prohibited definition of named function 'h'
		}
	}
}

---

## a named function is a definition, not an expression

k := (fun qq(t) (+ t 20)) ##ERROR: syntax error - prohibited definition of named function 'qq'

---

## '#rebind' takes over a name that is already bound, so it needs a name of its
## own to take over. an unnamed function binds nothing.

k := (fun[#rebind] (x) x) ##ERROR: syntax error - function attribute '#rebind' prohibited on an unnamed function

---

## a method lives in a class dictionary, which has a duplicate rule of its own

class A {
	fun[#rebind] m() { ##ERROR: syntax error - function attribute '#rebind' prohibited on a method
	}
}

---

## '#rebind' alone does not make a redefinition legal where the definition
## itself is not. the scope check comes first.

if true { fun[#rebind] h() { ##ERROR: syntax error - prohibited definition of named function 'h'
} }

---

## a builtin primitive is not a duplicate of anything the file declared. use
## '#rebind' to take the name over knowingly - see t/va-01.hak.

fun printf(a) { ##ERROR: syntax error - prohibited redefinition of primitive 'printf'
	return a
}

---

## '#rebind' overloads one callable with another. a name 'var' declared holds
## no callable, whatever value it was later given - see HAK_OBJ_FLAGS_VARKIND.

var x
fun[#rebind] x() { ##ERROR: syntax error - prohibited rebinding of variable 'x'
	return 1
}

---

## letting a function bury a class would make the load order of two files
## decide what the name means.

class K { }
fun[#rebind] K() { ##ERROR: syntax error - prohibited rebinding of class 'K'
	return 1
}

---

## a name mentioned somewhere is not a definition, so there is nothing to
## overload. the mention below is what puts 'm' in the system dictionary.

fun t() { return (m) }
fun[#rebind] m() { ##ERROR: syntax error - prohibited rebinding of undeclared name 'm'
	return 1
}

---

## nor is a name nothing has bound at all. '#rebind' says 'take over the
## existing definition', not 'define, and never mind whether there was one'.

fun[#rebind] zz() { ##ERROR: syntax error - prohibited rebinding of undeclared name 'zz'
	return 1
}

---

## a global a store created is a value, not a definition.

w := 5
fun[#rebind] w() { ##ERROR: syntax error - prohibited rebinding of name 'w'
	return 1
}
