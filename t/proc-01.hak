z1 := 0
z2 := 0

fun loop1() {
	| k |

	k := 1
	while (< k 100) {
		printf "loop1 => %d\n" k
		k := (+ k 2)
		core.yield
	}

	z1 := k
	core.sem-signal s1
}

fun loop2() {
	| k |

	k := 0
	while (< k 100) {
		printf "loop2 => %d\n" k
		k := (+ k 2)
		core.yield
	}

	z2 := k
	core.sem-signal s2
}

s1 := (core.sem-new)
s2 := (core.sem-new)

p1 := (core.fork loop1)
p2 := (core.fork loop2)

##core.suspend p1
##core.suspend p2
##core.resume p1
##core.resume p2

core.sem-wait s1
core.sem-wait s2

if (== z1 101) { printf "OK: z1 is %d\n" z1 } \
else { printf "ERROR: z1 is not 101 - %d\n" z1 }
if (== z2 100) { printf "OK: z2 is %d\n" z2 } \
else { printf "ERROR: z1 is not 100 - %d\n" z2 }
