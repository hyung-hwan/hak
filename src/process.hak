$include-once "object.hak"

class[#uncopyable #final #limited #varying] Process: Object(
	_initial_context
     _current_context
     _id
     _state
	_sp
	_st
	_exsp
	_exst
	_clsp
	_clst
	_fsp
	_fst
	_sched_prev
	_sched_next
	_sem_wawit_prev
	_sem_wait_next
	_sem
) {

	## The process this code is running in.
	fun[#class] active() {
		return (core.active-process)
	}

	## Start fnc in a new process and answer it. The new process is made
	## runnable but is not switched to here - this call returns first, and
	## the new one runs when the scheduler next gets the chance. t/tick-01.hak
	## depends on that and says so.
	##
	## [TODO] core.fork relays further arguments to fnc and this cannot, so a
	## caller that needs to pass any still goes to the primitive - see
	## t/mutex-01.hak. A '...' parameter would let this ACCEPT them, but
	## nothing in the language can then pass them on, so they would be
	## dropped in silence; taking exactly one argument at least makes the
	## attempt fail where it is made. The same gap Mutex:critical notes.
	fun[#class] fork(fnc) {
		return (core.fork fnc)
	}

	## Give the scheduler a chance to run somebody else. Answers when this
	## process is next scheduled.
	fun[#class] yield() {
		return (core.yield)
	}

	## Terminate every process there is.
	##
	## [IMPORTANT] that includes the one making the call. There is no active
	## process left afterwards, so this does not return and nothing written
	## after it runs - it is a way to stop, not a way to tidy up before
	## carrying on. Suspended processes go too, not just runnable ones.
	fun[#class] terminateAll() {
		return (core.terminate-all)
	}

	## TODO: add many read-only methods
	fun id() {
		return self._id
	}

	fun state() {
		return self._state
	}

	## --- scheduling ----------------------------------------------------
	##
	## Each answers the process, and each may change which process is the
	## active one - suspending or terminating the caller's own process hands
	## control to somebody else before the call appears to return.

	## Make a suspended process runnable again.
	fun resume() {
		return (core.resume self)
	}

	## Take it out of the run queue until resumed. Applied to the active
	## process - (Process:active):suspend - this is the primitive's
	## no-argument form.
	fun suspend() {
		return (core.suspend self)
	}

	## Stop it for good.
	fun terminate() {
		return (core.terminate self)
	}
}
