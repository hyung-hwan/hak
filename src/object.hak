class Apex {
	fun isNil?() { return false }
	fun notNil?() { return true }

	fun[#class] basicNew(size) {
		return (core.basicNew self size)
	}

	fun[#class] respondsTo(mthname) {
		return (core.classRespondsTo self mthname)
	}

	fun respondsTo(mthname) {
		return (core.instRespondsTo self mthname)
	}

	fun primAt(pos) {
		return (core.primAt self pos)
	}

	fun primtAtPut(pos value) {
		return (core.primAtPut self pos value)
	}

	fun basicAt(pos) {
		return (core.basicAt self pos)
	}

	fun basicAtPut(pos value) {
		return (core.basicAtPut self pos value)
	}

	fun basicSize() {
		return (core.basicSize self)
	}

	## --- identity and equality -------------------------------------------
	##
	## == and != are identity. = and ~= are equality, which is identity
	## unless a class says otherwise; a class that redefines = must redefine
	## hash so that equal objects hash alike.
	##
	## hash must also agree with the virtual machine for the values it hashes
	## itself (nil, true, false, small integers, characters, strings, symbols,
	## byte arrays, big integers): a Dictionary built by C code for a #{ }
	## literal is read by the hak code in collection.hak and the other way
	## round, and both must probe the same slot.
	fun == (oprnd) { return (eqv? self oprnd) }
	fun != (oprnd) { return (nqv? self oprnd) }
	fun = (oprnd) { return (eqv? self oprnd) }
	fun ~= (oprnd) { return (not (self = oprnd)) }

	fun hash() {
		## nil, true and false are objects but the vm hashes them by value
		if (or (nil? self) (boolean? self)) { return (core.hash self) }
		return (core.identityHash self)
	}

	fun identityHash() { return (core.identityHash self) }

	## --- errors ----------------------------------------------------------

	fun error(msg) { throw msg }
	fun subclassResponsibility(name) { throw (sprintf "%O must implement %O" (core.classOf self) name) }

	## TODO: fun perform(name ...) {}
}
 
class[#uncopyable #varying #limited #final] Class: Apex (
	_name
	_mdic
	_spec
	_selfspec
	_superclass
	_nivars_super
	_ibrand
	_ivarnames
	_cvarnames
) {
	fun name() {
		##return (core.className self)
		return _class
	}

	fun instanceVariableNames() {
		## TODO: this still returns nil as the acutal manipulation of the field has not been implemented
		return _ivarnames
	}

	fun classVariableNames() {
		## TODO: this still returns nil as the acutal manipulation of the field has not been implemented
		return _cvarnames
	}
}

class UndefinedObject: Apex {
	fun isNil?() { return true }
	fun notNil?() { return false }
}

## nil itself is an instance of NilObject, not of UndefinedObject.
class NilObject: Apex {
	fun isNil?() { return true }
	fun notNil?() { return false }
}

class Object: Apex {
}
